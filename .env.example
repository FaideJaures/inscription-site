# MongoDB connection string. The same database as the 2025 app works as-is:
# admins are still read from its `users` collection, and its registrations
# show up in the admin under "Archive 2025". New registrations go to
# `registrations`.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/mbaya

# Verification codes (e-mail and WhatsApp) are sent through OmniManager's
# public API, with a tenant API key confined to the CPE's shop
# (permissions: messages.send, contacts.write).
OMNI_API_URL=https://console.omni-manager.com
OMNI_API_KEY=omk_live_xxxxxxxxxxxxxxxx
OMNI_SHOP=mbaya

# Dev only (ignored in production): print codes to the server console
# instead of sending them.
# VERIFICATION_LOG_CODES=1
